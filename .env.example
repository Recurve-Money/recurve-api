# Railway injects DATABASE_URL automatically when a Postgres plugin is attached
DATABASE_URL=postgresql://user:pass@host:5432/railway

RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# From script/Deploy.s.sol output
REGISTRY_ADDRESS=
REVE_ADDRESS=

# Block the contracts went up. Scanning from 0 wastes hours.
DEPLOY_BLOCK=0

# Comma separated: slug:vault:governor:name
# e.g. first:0xabc...:0xdef...:First Fund
VAULTS=

# How often to poll for new blocks, and how many blocks per getLogs call
POLL_MS=12000
LOG_CHUNK=2000

PORT=3000
